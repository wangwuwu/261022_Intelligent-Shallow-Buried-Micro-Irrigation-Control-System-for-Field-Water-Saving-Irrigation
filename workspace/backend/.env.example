# 监听地址与端口
IRRIGATION_HOST=127.0.0.1
IRRIGATION_PORT=3001

# SQLite 数据库文件；目录必须存在且只允许服务账号读写
IRRIGATION_DB=var/irrigation.sqlite

# 导出文件目录（真实 CSV 文件，不写入数据库 blob）
IRRIGATION_EXPORT_DIR=exports

# 前端构建产物目录；留空则不提供静态页面
IRRIGATION_STATIC_DIR=../frontend/dist

# 会话 Cookie 安全属性。生产 HTTPS 时设为 1；本地 HTTP 调试保持 0
IRRIGATION_SECURE_COOKIE=0
# 反向代理终止 TLS 时设为 1，用于 Origin 同源校验
IRRIGATION_TRUST_PROXY=0

# 设备通道：当前仅支持 disabled。未取得厂家协议、点表和联动签核前拒绝现场控制。
IRRIGATION_DEVICE_CHANNEL=disabled

# 允许的浏览器 Origin，多个用逗号分隔；留空时自动使用请求 Host
IRRIGATION_ALLOWED_ORIGINS=
